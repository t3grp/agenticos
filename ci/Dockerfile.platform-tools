FROM ghcr.io/astral-sh/uv:0.13.7 AS uv
FROM oven/bun:1.3.5 AS bun
FROM docker:28.5.1-cli AS docker-cli
FROM mcr.microsoft.com/playwright:v1.63.0-noble

COPY --from=uv /uv /uvx /usr/local/bin/
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/ /usr/local/libexec/docker/cli-plugins/
RUN ln -sf /usr/local/bin/bun /usr/local/bin/bunx \
    && apt-get update -o Acquire::Retries=3 -o Acquire::http::Timeout=30 \
    && apt-get install -y --no-install-recommends git make ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

ENV UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_LINK_MODE=copy \
    UV_NO_PROGRESS=1 \
    NEXT_TELEMETRY_DISABLED=1 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
RUN uv python install 3.15
ENV UV_PYTHON_DOWNLOADS=never
WORKDIR /workspace
ENTRYPOINT []
CMD ["/bin/bash"]
